// Auctra Bidding Engine & Concurrency Engine — Prisma Schema
// Database: PostgreSQL (Shared Auctra Database)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Enums
enum UserRole {
  BUYER
  SELLER
  ADMIN
  MODERATOR
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  BANNED
  DELETED
}

enum SellerStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Product & Auction Enums
enum ProductCondition {
  NEW
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
}

enum ProductStatus {
  DRAFT
  AVAILABLE
  IN_AUCTION
  SOLD
  ARCHIVED
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  LIVE
  EXTENDED
  ENDED
  SOLD
  UNSOLD
  CANCELLED
}

enum BidType {
  MANUAL
  AUTO
}

enum NotificationType {
  AUCTION_WON
  AUCTION_OUTBID
  AUCTION_ENDED_PARTICIPANT
  AUCTION_BID_PLACED
  SYSTEM
}

// Users Table (Auth & User Services)
model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique @db.VarChar(255)
  username      String     @unique @db.VarChar(50)
  passwordHash  String     @map("password_hash") @db.VarChar(255)
  firstName     String     @map("first_name") @db.VarChar(100)
  lastName      String     @map("last_name") @db.VarChar(100)
  phone         String?    @unique @db.VarChar(20)
  avatarUrl     String?    @map("avatar_url") @db.VarChar(500)
  bio           String?    @db.Text
  role          UserRole   @default(BUYER)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relations
  addresses      Address[]
  sellerProfile  SellerProfile?
  refreshTokens  RefreshToken[]
  products       Product[]
  sellerAuctions Auction[]      @relation("SellerAuctions")
  wonAuctions    Auction[]      @relation("WinnerAuctions")
  watchlists     Watchlist[]
  bids           Bid[]
  autoBids       AutoBid[]
  notifications  Notification[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([status])
  @@map("users")
}

// Refresh Tokens Table (Auth Service)
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  deviceInfo String?   @map("device_info") @db.VarChar(500)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  expiresAt  DateTime  @map("expires_at")
  revoked    Boolean   @default(false)
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// User Addresses (User Service)
model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  fullName    String   @map("full_name") @db.VarChar(100)
  phone       String   @db.VarChar(20)
  streetLine1 String   @map("street_line1") @db.VarChar(255)
  streetLine2 String?  @map("street_line2") @db.VarChar(255)
  city        String   @db.VarChar(100)
  state       String   @db.VarChar(100)
  postalCode  String   @map("postal_code") @db.VarChar(20)
  country     String   @default("IN") @db.VarChar(50)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// Seller Profiles (User Service)
model SellerProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @map("user_id") @db.Uuid
  storeName          String       @unique @map("store_name") @db.VarChar(100)
  storeDescription   String?      @map("store_description") @db.Text
  businessType       String       @default("INDIVIDUAL") @map("business_type") @db.VarChar(50)
  taxId              String?      @map("tax_id") @db.VarChar(50)
  bankAccountNumber  String?      @map("bank_account_number") @db.VarChar(50)
  bankIfsc           String?      @map("bank_ifsc") @db.VarChar(50)
  verificationStatus SellerStatus @default(PENDING) @map("verification_status")
  rejectionReason    String?      @map("rejection_reason") @db.Text
  ratingAverage      Decimal      @default(0.00) @map("rating_average") @db.Decimal(3, 2)
  ratingCount        Int          @default(0) @map("rating_count")
  verifiedAt         DateTime?    @map("verified_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("seller_profiles")
}

// Categories
model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  icon        String?   @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")

  products    Product[]

  @@map("categories")
}

// Products
model Product {
  id             String           @id @default(uuid()) @db.Uuid
  sellerId       String           @map("seller_id") @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  title          String           @db.VarChar(255)
  description    String           @db.Text
  condition      ProductCondition @default(EXCELLENT)
  specifications Json             @default("{}")
  status         ProductStatus    @default(DRAFT)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  seller         User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category       Category         @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  auction        Auction?

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

// Product Images
model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(1000)
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// Auction Engine Model
model Auction {
  id                     String        @id @default(uuid()) @db.Uuid
  productId              String        @unique @map("product_id") @db.Uuid
  sellerId               String        @map("seller_id") @db.Uuid
  startingPrice          Decimal       @map("starting_price") @db.Decimal(12, 2)
  reservePrice           Decimal?      @map("reserve_price") @db.Decimal(12, 2)
  minIncrement           Decimal       @default(100.00) @map("min_increment") @db.Decimal(12, 2)
  buyNowPrice            Decimal?      @map("buy_now_price") @db.Decimal(12, 2)
  currentHighestBid      Decimal?      @map("current_highest_bid") @db.Decimal(12, 2)
  currentHighestBidderId String?       @map("current_highest_bidder_id") @db.Uuid
  bidCount               Int           @default(0) @map("bid_count")
  startTime              DateTime      @map("start_time")
  endTime                DateTime      @map("end_time")
  status                 AuctionStatus @default(DRAFT)
  antiSnipingTriggered   Boolean       @default(false) @map("anti_sniping_triggered")
  winningBid             Decimal?      @map("winning_bid") @db.Decimal(12, 2)
  winnerId               String?       @map("winner_id") @db.Uuid
  endedAt                DateTime?     @map("ended_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  product                Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller                 User          @relation("SellerAuctions", fields: [sellerId], references: [id], onDelete: Cascade)
  winner                 User?         @relation("WinnerAuctions", fields: [winnerId], references: [id])
  watchlists             Watchlist[]
  bids                   Bid[]
  autoBids               AutoBid[]

  @@index([sellerId])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@map("auctions")
}

// Buyer Watchlists
model Watchlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  auctionId String   @map("auction_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionId])
  @@index([userId])
  @@map("watchlists")
}

// Bids Table
model Bid {
  id             String    @id @default(uuid()) @db.Uuid
  auctionId      String    @map("auction_id") @db.Uuid
  bidderId       String    @map("bidder_id") @db.Uuid
  amount         Decimal   @db.Decimal(12, 2)
  bidType        BidType   @default(MANUAL) @map("bid_type")
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(100)
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  createdAt      DateTime  @default(now()) @map("created_at")

  auction        Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder         User      @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt])
  @@index([bidderId])
  @@index([idempotencyKey])
  @@map("bids")
}

// Auto Bids Table (Proxy Bidding)
model AutoBid {
  id             String    @id @default(uuid()) @db.Uuid
  auctionId      String    @map("auction_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  maxBudget      Decimal   @map("max_budget") @db.Decimal(12, 2)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  auction        Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([auctionId, userId])
  @@index([auctionId, isActive])
  @@index([userId])
  @@map("auto_bids")
}

// Notifications Table
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType @default(SYSTEM)
  title     String           @db.VarChar(255)
  message   String           @db.Text
  data      Json             @default("{}")
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}
