PORT=3007
NODE_ENV=development

DATABASE_URL="postgresql://postgres:password@localhost:5432/Auctra"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="auctra-dev-access-secret-key-change-in-production"

