# ============================================
# Auctra Auth Service — Environment Variables
# ============================================

# App
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auctra_auth

# MongoDB
MONGODB_URI=mongodb://localhost:27017/auctra_auth_logs

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# SMTP (Gmail)
# Generate App Password: Google Account → Security → 2FA → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_OTP_WINDOW_SECONDS=900
